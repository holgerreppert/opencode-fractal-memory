{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "no-unused-vars": ["warn", {
      "fix": {
        "imports": "safe-fix",
        "variables": "fix"
      },
      "varsIgnorePattern": "^_",
      "argsIgnorePattern": "^_"
    }],
    "no-empty": "warn",
    "no-empty-function": "warn",
    "no-constant-condition": "off",
    "unicorn/no-new-array": "off",
    "unicorn/no-useless-fallback-in-spread": "off"
  },
  "overrides": [
    {
      "files": ["*.test.ts", "*.test.js", "scripts/**", "benchmark/**"],
      "rules": {
        "no-unused-vars": "off",
        "no-empty-function": "off",
        "no-empty": "off"
      }
    },
    {
      "files": ["management/public/alpine.local.js", "management/public/alpine-components.js"],
      "rules": {
        "no-unused-vars": "off",
        "no-unused-expressions": "off",
        "no-empty-function": "off",
        "no-empty": "off",
        "no-useless-escape": "off"
      }
    }
  ]
}
